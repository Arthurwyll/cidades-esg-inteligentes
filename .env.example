# Copie para .env e ajuste os valores:  cp .env.example .env
POSTGRES_DB=esg
POSTGRES_USER=esg
POSTGRES_PASSWORD=troque-esta-senha

# Ambiente exibido em /api/info (local | staging | production)
APP_ENV=local
# Porta publicada no host
APP_PORT=8080

# Imagem usada pelo compose (o pipeline sobrescreve esta variavel no deploy)
APP_IMAGE=cidades-esg:local
